{
  "_comment": "Platform-specific runtime paths. output_dir is the base folder for dated download subfolders.",
  "Darwin": {
    "python_path": "$HOME/miniconda3/envs/new-env/bin/python",
    "base_dir": "$HOME/Desktop/bashful-backup",
    "output_dir": "./outputs/",
    "logging": {
      "level": "DEBUG",
      "log_to_file": true,
      "log_filename": "./logs/dl.log",
      "log_to_console": true,
      "console_level": "INFO"
    }
  },
  "Linux": {
    "python_path": "$HOME/miniconda3/envs/dl_wm/bin/python",
    "base_dir": "$HOME/Desktop/dl_wm",
    "output_dir": "./outputs/",
    "logging": {
      "level": "DEBUG",
      "log_to_file": true,
      "log_filename": "./logs/dl.log",
      "log_to_console": true,
      "console_level": "INFO"
    }
  }
}
